# Container image build
OPENCODE_VERSION=latest

# Web access. Replace both values before exposing through Nginx.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
OPENCODE_PORT=4096

# Active key route: shared or separate.
KEY_MODE=shared

# Temporary common gateway mode (AITunnel).
AITUNNEL_API_KEY=

# Direct-provider mode. Fill only before switching to separate.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Compatibility alias used by some Google SDK versions.
GEMINI_API_KEY=

# Optional GitHub access for private repositories. Prefer a fine-grained token.
GH_TOKEN=

# Git identity used only inside the isolated container.
GIT_AUTHOR_NAME=AI Development Department
GIT_AUTHOR_EMAIL=ai-department@local
GIT_COMMITTER_NAME=AI Development Department
GIT_COMMITTER_EMAIL=ai-department@local

