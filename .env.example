# Reproducible runtime versions
OPENCODE_VERSION=1.18.27
LITELLM_VERSION=1.98.0

# Web access. Both services bind only to localhost on the host.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
OPENCODE_PORT=4096
OPENCODE_PUBLIC_URL=http://127.0.0.1:4096

CONTROL_PLANE_SERVER_USERNAME=manager
CONTROL_PLANE_SERVER_PASSWORD=CHANGE_ME_MANAGER_PASSWORD
CONTROL_PLANE_PORT=8088
CONTROL_PLANE_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
CONTROL_PLANE_DEFAULT_MONTHLY_BUDGET=25000

# Internal Model Router credentials.
# master = administrative credential used only by router/gateway/host control scripts.
# client = inference-only credential exposed to OpenCode through Model Gateway.
MODEL_ROUTER_MASTER_KEY=CHANGE_ME_MODEL_ROUTER_MASTER_KEY
MODEL_ROUTER_CLIENT_KEY=CHANGE_ME_MODEL_ROUTER_CLIENT_KEY
MODEL_GATEWAY_PORT=18089

# Active provider route: shared (AITunnel) or separate (direct provider APIs).
KEY_MODE=shared

BACKUP_RETENTION_DAYS=14

# Git identity inside the isolated coding container.
# Values are quoted because bootstrap/preflight source this file after copying it to .env.
GIT_AUTHOR_NAME="AI Development Department"
GIT_AUTHOR_EMAIL=ai-department@local
GIT_COMMITTER_NAME="AI Development Department"
GIT_COMMITTER_EMAIL=ai-department@local
