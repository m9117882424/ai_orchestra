# Provider secrets are isolated from OpenCode and are loaded only by Model Router.
# Never commit this file after copying it to .env.providers.

# Shared gateway
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Direct providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Future providers: add only the key here and a deployment in config/model-router.separate.yaml.
# Examples:
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
