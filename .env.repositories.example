# Credentials are available only to the trusted Repo Manager container.
# Keep this object empty for public repositories. For a private HTTPS remote use:
# Keep the JSON single-quoted so Docker Compose treats every credential byte literally.
# REPO_MANAGER_AUTH_PROFILES_JSON='{"git-readonly-primary":{"host":"github.com","username":"x-access-token","password":"REPLACE_WITH_READ_ONLY_TOKEN"}}'
REPO_MANAGER_AUTH_PROFILES_JSON='{}'
