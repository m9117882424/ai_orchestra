map_hash_bucket_size 128;

map $http_authorization $orchestra_client_ok {
    default 0;
    "Bearer ${MODEL_ROUTER_CLIENT_KEY}" 1;
}

server {
    listen 8080;
    server_name _;

    client_max_body_size 20m;

    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location ~ ^/v1/(models|chat/completions|responses)$ {
        if ($orchestra_client_ok = 0) { return 401; }

        proxy_pass http://model-router:4000;
        proxy_http_version 1.1;
        proxy_set_header Host model-router;
        proxy_set_header Authorization "Bearer ${MODEL_ROUTER_MASTER_KEY}";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        return 404;
    }
}
