# Host-side disposable runner broker. Never place provider/Git/DB secrets here.
RUNNERD_SOCKET_PATH=/run/ai-orchestra/runnerd.sock
RUNNERD_WORKSPACE_VOLUME=ai-development-department_task-workspaces
# Required at runtime: exact local Docker image ID, not a mutable tag.
RUNNERD_IMAGE_ID=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
RUNNERD_MAX_TIMEOUT_SECONDS=900
RUNNERD_MAX_OUTPUT_BYTES=1048576
RUNNERD_MAX_CONCURRENT=2
RUNNERD_MEMORY=1g
RUNNERD_CPUS=1.0
RUNNERD_PIDS_LIMIT=128
RUNNERD_WORKSPACE_TMPFS_BYTES=536870912
